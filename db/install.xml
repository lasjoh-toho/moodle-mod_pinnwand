<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/pinnwand/db" VERSION="2026083019" COMMENT="XMLDB file for module pinnwand">
  <TABLES>
    <TABLE NAME="pinnwand" COMMENT="Instances of the pinnwand activity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="maxpictures" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0 = unlimited"/>
        <FIELD NAME="allowconsent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="boarddefault" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Neue Fotos werden standardmäßig auf der Pinnwand gezeigt"/>
        <FIELD NAME="studentcansend" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Lernende dürfen eigene Fotos zur Pinnwand senden/entfernen"/>
        <FIELD NAME="teachercansend" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Lehrkräfte dürfen beliebige Fotos zur Pinnwand senden/entfernen"/>
        <FIELD NAME="studentclassview" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Lernende dürfen die Klassenansicht (nur ansehen) öffnen"/>
        <FIELD NAME="boardpannable" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Pinnwand ist per Hand-Werkzeug verschiebbar und per Slider zoombar"/>
        <FIELD NAME="sidebaropacity" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="92" SEQUENCE="false" COMMENT="Deckkraft des Seitenleisten-Hintergrunds in Prozent (0-100)"/>
        <FIELD NAME="studentthreads" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Lernende dürfen eigene Rote Fäden über die Pinnwand legen"/>
        <FIELD NAME="studentpoststream" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Lernende dürfen den Post-Stream (eigenen Warteraum) nutzen"/>
        <FIELD NAME="studentlayers" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Lernende dürfen das Schichtung-Panel (Z-Reihenfolge) nutzen"/>
        <FIELD NAME="consenttext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="pinnwand_photos" COMMENT="Individual captured/processed photos">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pinnwandid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="gridtype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none" SEQUENCE="false" COMMENT="none|square|fixed"/>
        <FIELD NAME="gridvalue" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="consent" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="sourceauthor" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourceyear" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourceepoch" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourceplace" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourceorigauthor" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="sourcetitle" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="gridcolor" TYPE="char" LENGTH="7" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="hiddenfromboard" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Von der Pinnwand ausgeblendet"/>
        <FIELD NAME="annotationonboard" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Zeichen-/Schreib-Ebene auf der Pinnwand anzeigen"/>
        <FIELD NAME="annotationdata" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON-Array der Zeichen-/Schreib-Striche (vektoriell, normalisierte Koordinaten)"/>
        <FIELD NAME="canvasx" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="canvasy" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="canvasw" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="200" SEQUENCE="false"/>
        <FIELD NAME="canvasrot" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="canvasz" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="boardid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Zuordnung zu einem von mehreren Boards; 0 = erstes/Standard-Board"/>
        <FIELD NAME="sourcephotoid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Falls über den Post-Stream von einem fremden Foto übernommen: dessen ursprüngliche ID"/>
        <FIELD NAME="backphotoid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Verknüpfte Rückseite (eigenes Foto derselben Person) - per Doppelklick auf der Pinnwand umblätterbar"/>
        <FIELD NAME="showingback" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Welche Seite aktuell oben liegt: 0=Vorderseite, 1=Rückseite"/>
        <FIELD NAME="boardplaced" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Erst wenn 1: Foto hat reale Board-Koordinaten und erscheint auf der Leinwand - vorher liegt es im Post-Stream bereit"/>
        <FIELD NAME="wordfielddata" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Falls dieses 'Foto' ein Wortfeld ist: die strukturierten Daten (JSON: Preset, Maße, Texte) für erneutes Bearbeiten als Text statt als Bild"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pinnwandid" TYPE="foreign" FIELDS="pinnwandid" REFTABLE="pinnwand" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="pinnwand_threads" COMMENT="Roter Faden: ein Faden pro Person und Aktivität (Lehrkraft oder, falls erlaubt, Lernende)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pinnwandid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="color" TYPE="char" LENGTH="7" NOTNULL="true" DEFAULT="#e0503f" SEQUENCE="false"/>
        <FIELD NAME="bgmoves" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Hintergrund bewegt sich während der Präsentation mit dem Kamera-Zoom mit (statt bildschirmfüllend stehenzubleiben)"/>
        <FIELD NAME="linewidth" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="3" SEQUENCE="false" COMMENT="Dicke der Fadenlinie und der Rahmen-Umrandung in px"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pinnwandid" TYPE="foreign" FIELDS="pinnwandid" REFTABLE="pinnwand" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="pinnwand_thread_items" COMMENT="Einzelne Stationen (Foto oder Leerrahmen) eines Roten Fadens, in Reihenfolge">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="threadid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="itemtype" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="photo" SEQUENCE="false" COMMENT="photo|frame"/>
        <FIELD NAME="photoid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="boardid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="framex" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="framey" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="framew" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="frameh" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="framerot" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Rotation des Leerrahmens in Grad"/>
        <FIELD NAME="framez" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Z-Reihenfolge des Leerrahmens relativ zu Fotos auf dem Board"/>
        <FIELD NAME="framelabel" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="threadid" TYPE="foreign" FIELDS="threadid" REFTABLE="pinnwand_threads" REFFIELDS="id"/>
        <KEY NAME="photoid" TYPE="foreign" FIELDS="photoid" REFTABLE="pinnwand_photos" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="pinnwand_board_ink" COMMENT="Freihand-Anmerkungen direkt auf dem Hintergrund eines Boards (Stylus-Werkzeug), ein Datensatz pro Person und Board">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="pinnwandid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="boardid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="strokedata" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON-Array der Striche (dasselbe Format wie Foto-Annotationen)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="pinnwandid" TYPE="foreign" FIELDS="pinnwandid" REFTABLE="pinnwand" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userboard" UNIQUE="true" FIELDS="pinnwandid, userid, boardid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
